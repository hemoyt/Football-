# ═══════════════════════════════════════════════════════════════
# GOG — Environment Variables
# Copy this file to .env.local for local development
# Set these as Environment Variables in your Vercel project settings
# ═══════════════════════════════════════════════════════════════

# ── MySQL Database ──────────────────────────────────────────────
# Supports: PlanetScale, Railway, Aiven, TiDB Cloud, or any MySQL host
MYSQL_HOST=your-mysql-host.example.com
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=gog_db

# Set to "false" only if your MySQL host doesn't support SSL
# MYSQL_SSL=false

# ── JWT Secret ──────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-secret-string

# ── Admin Credentials (set in DB) ───────────────────────────────
# Default admin is seeded via db/schema.sql
# Email:    admin@gog.football
# Password: Admin@GOG2024
# Change the password after first login!
